kind = "app"
name = "oobe"
title = "Install D-OS"
version = "1.0.0"
binary = "oobe.dx"
description = "Unified disk installer and first-boot setup (language, keyboard, timezone, network, account)"
pinned = true
autostart = false

[permissions]
required = [
    "window",
    "storage:admin",
    "display:admin",
    "identity:query",
    "identity:admin",
    "net:status",
    "net:control",
]

[quota]
memory = "64M"
handles = 256
threads = 4
