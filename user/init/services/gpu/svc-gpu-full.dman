# GPU test service with full query/display/render grants: verifies scanout, modes, cursor, CS, and driver crash recovery.
name = "svc-gpu-full"
image = "ltest.dx"
args = "svc-gpu-full"
group = "test"
after = ["gpu", "svc-gpu-queryonly"]

[grants]
log = true
gpu = ["query", "display", "render"]

[quota]
memory = "32M"
handles = 128
threads = 4

[restart]
policy = "never"
