# The device manager: starts one driver process per device it knows, restarts drivers that fail,
# hands disks to the storage service and offers keyboard input on its input endpoint.
name = "devmgr"
image = "devmgr.dx"
group = "system"
after = ["storaged"]
description = "devices and their drivers"

[provides]
endpoints = ["input", "audio", "net", "gpu"]   # keyboard/pointer input, audio, network, and GPU driver endpoints

[grants]
log = true
devices = ["pci", "platform:ps2"]   # not the RTC: that is the clock's
programs = ["*.ddrv"]
connect = ["storaged.disks"]

[quota]
memory = "160M"
handles = 2048
threads = 48

[restart]
policy = "always"
limit = 3
backoff = 100
