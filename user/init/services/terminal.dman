# The terminal: the screen (the display device, taken from the kernel console) and the keyboard (the
# device manager's input endpoint); line editing and scrollback for the shell's session.
name = "terminal"
image = "terminal.dx"
group = "system"
description = "the screen and the keyboard"

[provides]
endpoints = ["session", "indicator", "display", "view"]   # the shell, the audio service's live mic indicator, the compositor, the graphical terminal

[grants]
log = true
devices = ["platform:display"]
connect = ["devmgr.input"]

[quota]
memory = "8M"
handles = 32
threads = 1

[restart]
policy = "always"
limit = 5
backoff = 100
