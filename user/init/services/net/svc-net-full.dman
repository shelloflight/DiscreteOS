# Network test service with full net grants: proves DHCP, DNS, ICMP, TCP, TLS 1.3 + X.509.
name = "svc-net-full"
image = "ltest.dx"
args = "svc-net-full"
group = "test"
after = ["net", "clock", "svc-net-ungranted"]

[grants]
log = true
connect = ["clock.time"]
net = ["client", "icmp", "control"]

[quota]
memory = "24M"
handles = 128
threads = 4

[restart]
policy = "never"
