# The graphical terminal: a window showing the terminal's shell session (the same session as the
# text console), opened when a desktop session starts and from the launcher. It draws only its own
# window and reads the session's cells from the terminal's view; it has no other authority.
name = "console"
image = "console.dsvc"
group = "system"
after = ["terminal", "awmi"]
description = "the graphical terminal"

[grants]
log = true
awmi = ["window"]
connect = ["terminal.view"]

[quota]
memory = "96M"
handles = 64
threads = 1

[restart]
policy = "always"
limit = 5
backoff = 200
