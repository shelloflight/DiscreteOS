# The built-in example apps of the desktop, written with the native toolkit: Widgets (every
# control) and About D-OS (the shortcuts). Opened from the launcher (or `gui demo`). An ordinary
# window client: it can draw its own windows, nothing else.
name = "awmi-demo"
image = "awmi-demo.dsvc"
group = "system"
description = "D-AWMI demo windows"

[grants]
log = true
awmi = ["window"]

[quota]
memory = "48M"
handles = 64
threads = 1

[restart]
policy = "always"
limit = 5
backoff = 200
